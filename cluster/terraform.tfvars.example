# Скопіюйте у terraform.tfvars і підставте своє.
# Файл terraform.tfvars у git НЕ потрапляє — див. .gitignore.

# Обов'язково: ваше прізвище латиницею, малими літерами.
prefix = "prizvyshche"

# Обов'язково: ваш ARN. Без нього kubectl отримає Unauthorized.
# Узяти: у CloudShell виконайте  aws sts get-caller-identity  і скопіюйте поле Arn.
cluster_admin_arns = [
  "arn:aws:iam::123456789012:user/imya",
]

# Скільки вузлів створити разом із групою. Пізніші зміни Terraform ігнорує:
# піднімати й опускати вузли — командою AWS CLI, див. README.
node_desired_size = 1

# SPOT за замовчуванням. Якщо вузол не піднімається — розкоментуйте:
# node_capacity_type = "ON_DEMAND"

# Решта має розумні значення за замовчуванням:
# node_instance_types = ["c7i-flex.large", "m7i-flex.large"]
# kubernetes_version  = "1.34"

# --- Заняття 9: після копіювання файлів із lessons/09-flux ---
# Адреса ВАШОГО публічного форку цього репозиторію.
